{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Unitron07/Asteria-Windows/blob/main/docs/performance-capture.schema.json",
  "title": "Asteria performance capture version 1",
  "type": "object",
  "required": ["schemaVersion", "application", "buildKind", "sourceRevision", "releaseBaseline", "architecture", "gpu", "backend", "codec", "video", "capture", "metrics", "counts", "limitations"],
  "properties": {
    "schemaVersion": {"const": 1},
    "application": {"const": "Asteria"},
    "buildKind": {"type": "string", "minLength": 1},
    "sourceRevision": {"type": "string", "minLength": 1},
    "releaseBaseline": {"type": "string", "minLength": 1},
    "architecture": {"type": "string", "minLength": 1},
    "gpu": {"type": "string", "minLength": 1},
    "driver": {"type": ["string", "null"]},
    "backend": {"type": "string", "minLength": 1},
    "decoderPath": {"type": "string"},
    "runId": {"type": "string"},
    "decoderLifetimeIndex": {"type": "integer", "minimum": 0},
    "decoderReportsOmitted": {"type": "integer", "minimum": 0},
    "codec": {
      "type": "object", "required": ["name", "commit", "bitstreamId", "apiVersion"],
      "properties": {
        "name": {"type": "string", "minLength": 1}, "commit": {"type": "string", "minLength": 1},
        "bitstreamId": {"type": "string", "minLength": 1}, "apiVersion": {"type": "string", "minLength": 1}
      }
    },
    "video": {
      "type": "object", "required": ["width", "height", "targetFps", "requestedBitrateKbps", "vsync"],
      "properties": {
        "width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1},
        "targetFps": {"type": "number", "exclusiveMinimum": 0},
        "requestedBitrateKbps": {"type": "number", "exclusiveMinimum": 0}, "vsync": {"type": "boolean"}
      }
    },
    "capture": {
      "type": "object", "required": ["durationSeconds", "requestedDurationSeconds", "warmupSeconds"],
      "properties": {
        "durationSeconds": {"type": "number", "minimum": 0},
        "requestedDurationSeconds": {"type": "number", "minimum": 0},
        "warmupSeconds": {"type": "number", "minimum": 0},
        "counterOverflow": {"type": "boolean"}, "storageBytes": {"type": "integer", "minimum": 0},
        "eventCapacity": {"const": 512}, "eventsOmitted": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "metrics": {"type": "object", "additionalProperties": {"$ref": "#/$defs/metric"}},
    "counts": {"type": "object", "additionalProperties": {"type": ["integer", "null"], "minimum": 0, "maximum": 9223372036854775807}},
    "frameEvents": {
      "type": "array", "maxItems": 512,
      "items": {
        "type": "object", "required": ["relativeUs", "frameNumber", "slot", "stage"],
        "properties": {
          "relativeUs": {"type": "integer", "minimum": 0},
          "frameNumber": {"type": "integer", "minimum": 0, "maximum": 4294967295},
          "slot": {"type": "integer", "minimum": -1, "maximum": 2},
          "stage": {"enum": ["received", "published", "submitted", "dropped", "rejected"]}
        }
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}},
    "nativeCodecReports": {"type": "object"},
    "observed": {"type": "object"}, "systemResources": {"type": "object"}, "benchmarkContext": {"type": "object"}
  },
  "$defs": {
    "statistic": {"type": ["number", "null"], "minimum": 0},
    "metric": {
      "type": "object",
      "required": ["unit", "scope", "clock", "sampleCount", "status", "percentileMethod", "mean", "minimum", "maximum", "p50", "p95", "p99"],
      "properties": {
        "unit": {"type": "string", "minLength": 1}, "scope": {"type": "string", "minLength": 1},
        "clock": {"type": "string", "minLength": 1}, "percentileMethod": {"type": "string", "minLength": 1},
        "sampleCount": {"type": ["integer", "null"], "minimum": 0},
        "status": {"enum": ["available", "unavailable", "overflow"]},
        "mean": {"$ref": "#/$defs/statistic"}, "minimum": {"$ref": "#/$defs/statistic"},
        "maximum": {"$ref": "#/$defs/statistic"}, "p50": {"$ref": "#/$defs/statistic"},
        "p95": {"$ref": "#/$defs/statistic"}, "p99": {"$ref": "#/$defs/statistic"}
      }
    }
  }
}
